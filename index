

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Bike Gallery</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background-color: #f9f9f9;
    }

    header {
      background-color: #2c3e50;
      color: white;
      text-align: center;
      padding: 1.5rem;
    }

    .controls {
      text-align: center;
      margin: 20px auto;
    }

    .controls input[type="text"] {
      width: 50%;
      padding: 12px;
      border-radius: 30px;
      border: 1px solid #ccc;
      font-size: 16px;
      outline: none;
      transition: all 0.3s ease;
    }

    .controls input[type="text"]:focus {
      border-color: #2980b9;
      box-shadow: 0 0 5px rgba(41, 128, 185, 0.5);
    }

    .filter-buttons {
      margin-top: 15px;
    }

    .filter-buttons button {
      background-color: #ecf0f1;
      border: none;
      padding: 10px 20px;
      margin: 5px;
      border-radius: 20px;
      cursor: pointer;
      font-weight: bold;
      transition: background-color 0.2s ease;
    }

    .filter-buttons button.active,
    .filter-buttons button:hover {
      background-color: #3498db;
      color: white;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 20px;
      padding: 20px;
    }

    .bike {
      background: white;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      transition: transform 0.3s ease, opacity 0.3s ease;
      text-align: center;
    }

    .bike img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .bike h3 {
      margin: 10px;
    }

    .hidden {
      opacity: 0;
      transform: scale(0.9);
      pointer-events: none;
    }
  </style>
</head>
<body>

<header>
  <h1>Bike Gallery</h1>
</header>

<div class="controls">
  <input type="text" id="searchBar" placeholder="Search for bikes..." onkeyup="filterGallery()" />
  <div class="filter-buttons">
    <button class="active" onclick="filterCategory('all')">All</button>
    <button onclick="filterCategory('mountain')">Mountain</button>
    <button onclick="filterCategory('road')">Road</button>
    <button onclick="filterCategory('electric')">Electric</button>
    <button onclick="filterCategory('bmx')">BMX</button>
    <button onclick="filterCategory('hybrid')">Hybrid</button>
    <button onclick="filterCategory('folding')">Folding</button>
  </div>
</div>

<div class="gallery" id="bikeGallery">
  <div class="bike" data-category="mountain">
    <img src="img/mountain bike.jpeg" alt="Mountain Bike" />
    <h3>Mountain Bike</h3>
  </div>
  <div class="bike" data-category="road">
    <img src="img/roadbike.jpeg" alt="Road Bike" />
    <h3>Road Bike</h3>
  </div>
  <div class="bike" data-category="electric">
    <img src="img/E-bike.webp" alt="Electric Bike" />
    <h3>Electric Bike</h3>
  </div>
  <div class="bike" data-category="bmx">
    <img src="img/bmx.jpeg" alt="BMX Bike" />
    <h3>BMX Bike</h3>
  </div>
  <div class="bike" data-category="hybrid">
    <img src="img/hybrid.jpg" alt="Hybrid Bike" />
    <h3>Hybrid Bike</h3>
  </div>
  <div class="bike" data-category="folding">
    <img src="img/fold.webp" alt="Folding Bike" />
    <h3>Folding Bike</h3>
  </div>
</div>

<script>
  let selectedCategory = 'all';

  function filterGallery() {
    const searchInput = document.getElementById('searchBar').value.toLowerCase();
    const bikes = document.querySelectorAll('.bike');

    bikes.forEach(bike => {
      const name = bike.querySelector('h3').innerText.toLowerCase();
      const category = bike.getAttribute('data-category');

      const matchText = name.includes(searchInput);
      const matchCategory = selectedCategory === 'all' || category === selectedCategory;

      if (matchText && matchCategory) {
        bike.classList.remove('hidden');
      } else {
        bike.classList.add('hidden');
      }
    });
  }

  function filterCategory(category) {
    selectedCategory = category;

    document.querySelectorAll('.filter-buttons button').forEach(btn => {
      btn.classList.remove('active');
    });

    event.target.classList.add('active');
    filterGallery();
  }
</script>

</body>
</html>
